{
  "name": "sr-books-erp",
  "version": "1.0.0",
  "private": true,
  "description": "SR-Books ERP — Enterprise Cloud Accounting & Management System architected by Srimanikandan K, licensed for Standard Roofs",
  "author": "Srimanikandan K (https://github.com/Srimani26)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "start": "next start -p 3000",
    "start:local": "next start -p 3000",
    "push:all": "powershell -ExecutionPolicy Bypass -File scripts/push-all.ps1",
    "backup:local": "powershell -ExecutionPolicy Bypass -File scripts/backup-local.ps1",
    "db:start": "node scripts/db-server.mjs start",
    "db:stop": "node scripts/db-server.mjs stop",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "decimal.js": "^10.5.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.17",
    "lucide-react": "^0.475.0",
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@embedded-postgres/windows-x64": "^18.6.0-beta.19",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "embedded-postgres": "^18.6.0-beta.19",
    "postcss": "^8.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
