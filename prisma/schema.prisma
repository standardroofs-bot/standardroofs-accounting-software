  startKm         Int
  closingKm       Int
  totalKm         Int
  fuelLiters      Decimal       @default(0.00) @db.Decimal(10, 2)
  fuelCost        Decimal       @default(0.00) @db.Decimal(15, 2)
  tollCost        Decimal       @default(0.00) @db.Decimal(15, 2)
  driverBata      Decimal       @default(0.00) @db.Decimal(15, 2)
  maintenanceCost Decimal       @default(0.00) @db.Decimal(15, 2)
  totalCost       Decimal       @default(0.00) @db.Decimal(15, 2)
  paymentMode     String        @default("CASH") // CASH, BANK
  bankAccountId   String?
  journalEntryId  String?       @unique
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

