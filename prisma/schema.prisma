  companyId       String        @default("standard-roofs")
  status          String        @default("DRAFT") // DRAFT | APPROVED | PAID
  totalGross      Float         @default(0)
  totalDeductions Float         @default(0)
  totalNet        Float         @default(0)
  paidCash        Float         @default(0)
  paidBank        Float         @default(0)
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           PayrollItem[]

  @@unique([cycleType, month, halfPeriod, companyFilter, companyId])
  @@index([month, cycleType])
  @@index([companyId])
}

model PayrollItem {
  id                      String     @id @default(cuid())
  payrollRunId            String
  employeeId              String
  employeeName            String
  employeeCode            String
  category                String     // OFFICE | TAMIL_LABOUR | HINDI_CREW
  company                 String     @default("STANDARD_ROOFS") // STANDARD_ROOFS | INVI_CREATION
  totalWorkingDays        Float      @default(25)
  daysPresent             Float      @default(0)
  leaveDays               Float      @default(0)
  baseRate                Float      @default(0)
  grossSalary             Float      @default(0)
  otAndIncentive          Float      @default(0)
  performanceIncentive    Float      @default(0)
  nightDutyAmount         Float      @default(0)
  vehicleAllowance        Float      @default(0)
  lastMonthBalance        Float      @default(0)
  advanceDeduction        Float      @default(0)
  expenseBalanceDeduction Float      @default(0)
  netSalary               Float      @default(0)
  paidCash                Float      @default(0)
  paidBankOrGpay          Float      @default(0)
  paidGpay                Float      @default(0)
  gpayWallet              String?
  paymentChannel          String     @default("CASH") // CASH | ICICI | OFFICE_GPAY | AGENT_ACCOUNT
  paymentStatus           String     @default("UNPAID") // PAID | PARTIAL | HOLD | UNPAID
  paymentReason           String?
  paymentRef              String?
  paidDate                DateTime?
  performanceScore        Int?
  carryForwardBalance     Float      @default(0)
  isCleared               Boolean    @default(false)
  notes                   String?
  designation             String?
  joiningDate             String?
  location                String?
  state                   String?
  mobileNo                String?
  aadhaarNo               String?
  bankName                String?
  accountNo               String?

  payrollRun              PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@index([payrollRunId])
  @@index([employeeId])
}

// -------------------------------------------------------------
// PHASE 2: STANDARD SUB-CONTRACTORS & RUNNING LEDGER
// -------------------------------------------------------------

model SubContractor {
  id             String                     @id @default(cuid())
  name           String                     @unique
  teamLead       String?
  phone          String?
  tradeCategory  String                     @default("Roofing & Fabrication")
  openingBalance Float                      @default(0)
  currentBalance Float                      @default(0)
  isActive       Boolean                    @default(true)
  notes          String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  entries        SubContractorLedgerEntry[]
}

model SubContractorLedgerEntry {
  id                String        @id @default(cuid())
  subContractorId   String
  entryDate         DateTime      @default(now())
  siteName          String?
  particulars       String
  entryType         String        // WORK_BILL | EXTRA_LABOUR | MATERIAL_DEDUCTION | PAYMENT | ADJUSTMENT
  sqft              Float         @default(0)
  ratePerSqft       Float         @default(0)
  otherAllowance    Float         @default(0)
  materialReduction Float         @default(0)
  amountToGive      Float         @default(0)
  givenAmount       Float         @default(0)
  runningBalance    Float         @default(0)
  walletUsed        String?
  notes             String?
  createdAt         DateTime      @default(now())

  subContractor     SubContractor @relation(fields: [subContractorId], references: [id], onDelete: Cascade)

  @@index([subContractorId, entryDate])
}




