datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  MANAGING_DIRECTOR
  ACCOUNTANT
  HR_MANAGER
  ACCOUNTS_EXECUTIVE
  PROJECT_MANAGER
  SITE_SUPERVISOR
  VIEWER
  EMPLOYEE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountSubType {
  CURRENT_ASSET
  BANK
  CASH
  FIXED_ASSET
  CURRENT_LIABILITY
  DUTIES_AND_TAXES
  DIRECT_INCOME
  INDIRECT_INCOME
  DIRECT_EXPENSE
  INDIRECT_EXPENSE
  EQUITY
}

enum VoucherType {
  INVOICE
  PAYMENT
  RECEIPT
  CONTRA
  EXPENSE
  PURCHASE
  JOURNAL_VOUCHER
  REVERSAL
  FLEET_TRIP
  INVENTORY_MOVEMENT
  STAFF_PAYROLL
  CAPITAL_TRANSACTION
  LOAN_DISBURSEMENT
  LOAN_EMI
  FIXED_ASSET_ACQUISITION
  DEPRECIATION
  CREDIT_NOTE
  DEBIT_NOTE
  ADVANCE_PAYMENT
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum CashFlowType {
  CASH_INFLOW
  CASH_OUTFLOW
}

enum ClosingStatus {
  BALANCED
  DISCREPANCY
}

enum BankTransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  INTEREST
  CHARGE
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum MachineStatus {
  AVAILABLE
  ALLOCATED
  IN_SERVICE
  SPARE
  SCRAP
}

enum MachineGroup {
  SRM01
  SRM02
  SRM03
  SRM04
  SRM05
  SRM06
  OFFICE
  SPARE
  SERVICE
  SCRAP
}

enum PayCycle {
  MONTHLY
  FIFTEEN_DAYS
  DAILY
}

enum RoleType {
  PERMANENT_STAFF
  DAILY_LABOUR
  SITE_FITTER
}

// -------------------------------------------------------------
// USER & RBAC
// -------------------------------------------------------------

model Company {
  id        String   @id
  code      String   @unique // STANDARD_ROOFS | INVI_CREATION
  name      String
  tagline   String?
  gstin     String?
  location  String   @default("Erode")
  address   String?
  phone     String?
  email     String?
  website   String?
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userAccess UserCompanyAccess[]
}

model UserCompanyAccess {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      UserRole @default(VIEWER)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

model User {
  id                     String            @id @default(cuid())
  name                   String
  email                  String            @unique
  passwordHash           String
  role                   UserRole          @default(VIEWER)
  phone                  String?
  permissions            Json?
  employeeId             String?
  defaultCompanyId       String            @default("standard-roofs")
  active                 Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  companyAccess          UserCompanyAccess[]
  journalEntriesCreated  JournalEntry[]    @relation("JournalCreatedBy")
  cashBookEntries        CashBookEntry[]   @relation("CashBookCreatedBy")
  dailyClosings          DailyCashClosing[] @relation("DailyClosingClosedBy")
  machineMovementsIssued MachineMovement[] @relation("MachineIssuedBy")
  machineMovementsApproved MachineMovement[] @relation("MachineApprovedBy")
  expensesApproved       ExpenseClaim[]    @relation("ExpenseApprovedBy")
  auditLogs              AuditLog[]
  importBatches          ImportBatch[]
}

// -------------------------------------------------------------
// FINANCIAL YEAR & SEQUENCING
// -------------------------------------------------------------

model FinancialYear {
  id             String            @id @default(cuid())
  name           String            @unique // "2026-27"
  startDate      DateTime
  endDate        DateTime
  isLocked       Boolean           @default(false)
  isClosed       Boolean           @default(false)
  isCurrent      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  voucherSequences VoucherSequence[]
  journalEntries   JournalEntry[]
  cashBookEntries  CashBookEntry[]
  dailyClosings    DailyCashClosing[]
  invoices         Invoice[]
  salesOrders      SalesOrder[]
  purchaseBills    PurchaseBill[]
  purchaseOrders   PurchaseOrder[]
}

model VoucherSequence {
  id              String        @id @default(cuid())
  financialYearId String
  voucherType     String        // INVOICE, CASH_RECEIPT, CASH_PAYMENT, BANK_RECEIPT, BANK_PAYMENT, CONTRA, JOURNAL_VOUCHER, PURCHASE_BILL, EXPENSE
  prefix          String        // SR/26-27/, CR/26-27/, CP/26-27/, etc.
  nextNumber      Int           @default(1)
  paddingLength   Int           @default(4)
  formatPattern   String        @default("{PREFIX}{NUMBER}")
  updatedAt       DateTime      @updatedAt

  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)

  @@unique([financialYearId, voucherType])
}

// -------------------------------------------------------------
// CHART OF ACCOUNTS
// -------------------------------------------------------------

model Account {
  id              String          @id @default(cuid())
  code            String          @unique // e.g. 1010, 2010, 4010
  name            String
  type            AccountType
  subType         AccountSubType
  description     String?
  isSystem        Boolean         @default(false)
  active          Boolean         @default(true)
  openingBalance  Decimal         @default(0.00) @db.Decimal(15, 2)
  currentBalance  Decimal         @default(0.00) @db.Decimal(15, 2)
  parentAccountId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  parentAccount   Account?        @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts   Account[]       @relation("AccountHierarchy")
  journalLines    JournalLine[]
  bankAccounts    BankAccount[]
  expenses        ExpenseClaim[]
}

// -------------------------------------------------------------
// DOUBLE-ENTRY BOOKKEEPING
// -------------------------------------------------------------

model JournalEntry {
  id               String          @id @default(cuid())
  entryNumber      String          @unique // JV/26-27/0001
  date             DateTime
  voucherType      VoucherType
  referenceNumber  String?
  narration        String
  financialYearId  String
  totalDebit       Decimal         @default(0.00) @db.Decimal(15, 2)
  totalCredit      Decimal         @default(0.00) @db.Decimal(15, 2)
  status           JournalStatus   @default(POSTED)
  isReversal       Boolean         @default(false)
  reversalOfId     String?         @unique
  reversalReason   String?
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  financialYear    FinancialYear   @relation(fields: [financialYearId], references: [id])
  createdBy        User            @relation("JournalCreatedBy", fields: [createdById], references: [id])
  reversalOf       JournalEntry?   @relation("ReversalRelation", fields: [reversalOfId], references: [id])
  reversedBy       JournalEntry?   @relation("ReversalRelation")
  lines            JournalLine[]
  cashBookEntry    CashBookEntry?
  bankTransactions BankTransaction[]
  invoice          Invoice?
  invoicePayments  InvoicePayment[]
  purchaseBill     PurchaseBill?
  expenseClaim     ExpenseClaim?
  labourMusters    LabourMuster[]
  labourAdvances   LabourAdvance[]
  vehicleTrip        VehicleTripLog?
  materialMovement   MaterialStockMovement?
  staffPayroll       StaffPayroll?
  capitalTransaction CapitalTransaction?
  businessLoan       BusinessLoan?
  loanEmiPayment     LoanEmiPayment?
  fixedAsset         FixedAsset?
  creditDebitNotes   CreditDebitNote[]
  customerAdvances   CustomerAdvance[]
  supplierAdvances   SupplierAdvance[]
  billPayment        BillPayment?
  importBatchId      String?
  importBatch        ImportBatch?    @relation(fields: [importBatchId], references: [id])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal      @default(0.00) @db.Decimal(15, 2)
  credit         Decimal      @default(0.00) @db.Decimal(15, 2)
  narration      String?
  projectId      String?
  customerId     String?
  supplierId     String?
  contractorId   String?
  createdAt      DateTime     @default(now())

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])
  project        Project?     @relation(fields: [projectId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id])
  supplier       Supplier?    @relation(fields: [supplierId], references: [id])
  contractor     Contractor?  @relation(fields: [contractorId], references: [id])
}

// -------------------------------------------------------------
// DAILY CASH BOOK & DENOMINATION CLOSING
// -------------------------------------------------------------

model CashBookEntry {
  id               String        @id @default(cuid())
  voucherNumber    String        @unique // CP/26-27/0001 or CR/26-27/0001
  date             DateTime
  type             CashFlowType
  amount           Decimal       @db.Decimal(15, 2)
  purpose          String
  category         String        // Site Expenses, Fuel, Material Purchase, Customer Receipt, etc.
  walletName       String        @default("Office Cash") // Office Cash | ICICI | Office Gpay | Ravi Gpay | Prabha Gpay | RBL | Periyasamy Gpay | Suji Cash
  counterpartyName String?
  receiptUrl       String?
  projectId        String?
  isOfficeExpense  Boolean       @default(false)
  teamName         String?
  companyId        String        @default("standard-roofs")
  importBatchId    String?
  financialYearId  String
  journalEntryId   String?       @unique
  createdById      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  financialYear    FinancialYear @relation(fields: [financialYearId], references: [id])
  journalEntry     JournalEntry? @relation(fields: [journalEntryId], references: [id])
  project          Project?      @relation(fields: [projectId], references: [id])
  createdBy        User          @relation("CashBookCreatedBy", fields: [createdById], references: [id])
  importBatch      ImportBatch?  @relation(fields: [importBatchId], references: [id])

  @@index([companyId])
}

model DailyCashClosing {
  id                   String        @id @default(cuid())
  closingDate          DateTime
  systemOpeningBalance Decimal       @db.Decimal(15, 2)
  totalInflow          Decimal       @db.Decimal(15, 2)
  totalOutflow         Decimal       @db.Decimal(15, 2)
  systemClosingBalance Decimal       @db.Decimal(15, 2)

  // Denominations Breakdown
  count500             Int           @default(0)
  count200             Int           @default(0)
  count100             Int           @default(0)
  count50              Int           @default(0)
  count20              Int           @default(0)
  count10              Int           @default(0)
  count5               Int           @default(0)
  count2               Int           @default(0)
  count1               Int           @default(0)

  physicalClosingTotal Decimal       @db.Decimal(15, 2)
  discrepancyAmount    Decimal       @default(0.00) @db.Decimal(15, 2)
  status               ClosingStatus @default(BALANCED)
  notes                String?
  closedById           String
  financialYearId      String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  financialYear        FinancialYear @relation(fields: [financialYearId], references: [id])
  closedBy             User          @relation("DailyClosingClosedBy", fields: [closedById], references: [id])

  @@unique([closingDate, financialYearId])
}

// -------------------------------------------------------------
// BANKING
// -------------------------------------------------------------

model BankAccount {
  id             String            @id @default(cuid())
  accountName    String            // e.g. HDFC Current A/c, ICICI CC A/c
  bankName       String
  accountNumber  String            @unique
  ifscCode       String
  branchName     String
  openingBalance Decimal           @default(0.00) @db.Decimal(15, 2)
  currentBalance Decimal           @default(0.00) @db.Decimal(15, 2)
  accountId      String            // Linked Chart of Accounts account
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  account          Account               @relation(fields: [accountId], references: [id])
  transactions     BankTransaction[]
  expenses         ExpenseClaim[]
  statementImports BankStatementImport[]
  capitalTrans     CapitalTransaction[]
  loans            BusinessLoan[]
  emiPayments      LoanEmiPayment[]
  billPayments     BillPayment[]
}

model BankTransaction {
  id               String              @id @default(cuid())
  voucherNumber    String              @unique // BP/26-27/0001 or BR/26-27/0001
  date             DateTime
  bankAccountId    String
  type             BankTransactionType
  amount           Decimal             @db.Decimal(15, 2)
  referenceNumber  String?             // UTR / Cheque / NEFT ref
  chequeNumber     String?
  payeeOrPayer     String
  purpose          String
  receiptUrl       String?
  isReconciled     Boolean             @default(false)
  reconciledAt     DateTime?
  bankStatementRef String?
  journalEntryId   String?
  category         String?             @default("UNCATEGORIZED") // UNCATEGORIZED, CUSTOMER_PAYMENT, VENDOR_PAYMENT, SITE_EXPENSE, LABOUR_CONTRACTOR, OFFICE_OVERHEAD, OWNER_CAPITAL, LOAN_EMI
  status           String              @default("UNCATEGORIZED")
  customerName     String?
  vendorName       String?
  projectName      String?
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  bankAccount      BankAccount         @relation(fields: [bankAccountId], references: [id])
  journalEntry     JournalEntry?       @relation(fields: [journalEntryId], references: [id])
}

model BankStatementImport {
  id              String        @id @default(cuid())
  bankAccountId   String
  fileName        String
  importDate      DateTime      @default(now())
  totalLines      Int           @default(0)
  reconciledLines Int           @default(0)
  notes           String?
  createdAt       DateTime      @default(now())

  bankAccount     BankAccount   @relation(fields: [bankAccountId], references: [id])
}

// -------------------------------------------------------------
// CUSTOMERS, PROJECTS & GST INVOICES (TN STATE CODE 33)
// -------------------------------------------------------------

model Customer {
  id                 String        @id @default(cuid())
  name               String
  companyName        String?
  gstNumber          String?       // 15-digit GSTIN
  panNumber          String?
  state              String        @default("Tamil Nadu")
  stateCode          String        @default("33") // 33 for TN
  billingAddress     String
  shippingAddress    String?
  siteAddress        String?
  googleMapsLink     String?
  length             Decimal?      @default(0.00) @db.Decimal(10, 2)
  breadth            Decimal?      @default(0.00) @db.Decimal(10, 2)
  email              String?
  phone              String?
  creditDays         Int           @default(30)
  openingBalance     Decimal       @default(0.00) @db.Decimal(15, 2)
  outstandingBalance Decimal       @default(0.00) @db.Decimal(15, 2)
  isArchived         Boolean       @default(false)
  archivedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  projects           Project[]
  invoices           Invoice[]
  salesOrders        SalesOrder[]
  estimates          Estimate[]
  journalLines       JournalLine[]
  creditDebitNotes   CreditDebitNote[]
  advances           CustomerAdvance[]
}

model Project {
  id                   String                @id @default(cuid())
  code                 String                @unique // SR-PRJ-2026-001
  name                 String
  customerId           String
  siteLocation         String
  city                 String                @default("Erode")
  state                String                @default("Tamil Nadu")
  stateCode            String                @default("33")
  roofType             String                @default("PEB") // Clay Tile, PEB, Tensile, UPVC, Solar, Other
  totalSqFt            Decimal               @default(0.00) @db.Decimal(15, 2)
  startDate            DateTime?
  targetCompletionDate DateTime?
  contractValue        Decimal               @default(0.00) @db.Decimal(15, 2)
  status               ProjectStatus         @default(IN_PROGRESS)
  description          String?
  assignedTeams        String?               @default("[\"SRM01\"]")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  customer             Customer              @relation(fields: [customerId], references: [id])
  invoices             Invoice[]
  estimates            Estimate[]
  salesOrders          SalesOrder[]
  purchaseBills        PurchaseBill[]
  purchaseOrders       PurchaseOrder[]
  expenses             ExpenseClaim[]
  cashBookEntries      CashBookEntry[]
  journalLines         JournalLine[]
  machineAllocations   MachineAllocation[]
  contractorMilestones ContractorMilestone[]
  vehicleTrips         VehicleTripLog[]
  materialMovements    MaterialStockMovement[]
  siteMaterialIssues   SiteMaterialIssue[]
}

model Invoice {
  id                      String           @id @default(cuid())
  invoiceNumber           String           @unique // SR/26-27/0033
  sequenceNumber          Int              // 33
  invoiceType             String           @default("TAX_INVOICE") // TAX_INVOICE, PROFORMA_INVOICE, ADVANCE_INVOICE, FINAL_INVOICE, CREDIT_NOTE, DEBIT_NOTE
  date                    DateTime
  dueDate                 DateTime?
  customerId              String
  projectId               String?
  financialYearId         String
  placeOfSupply           String           @default("Tamil Nadu")
  placeOfSupplyStateCode  String           @default("33")
  isInterState            Boolean          @default(false)
  subTotal                Decimal          @default(0.00) @db.Decimal(15, 2)
  cgstTotal               Decimal          @default(0.00) @db.Decimal(15, 2)
  sgstTotal               Decimal          @default(0.00) @db.Decimal(15, 2)
  igstTotal               Decimal          @default(0.00) @db.Decimal(15, 2)
  adjustment              Decimal          @default(0.00) @db.Decimal(15, 2)
  totalAmount             Decimal          @default(0.00) @db.Decimal(15, 2)
  amountPaid              Decimal          @default(0.00) @db.Decimal(15, 2)
  tdsDeducted             Decimal          @default(0.00) @db.Decimal(15, 2)
  balanceDue              Decimal          @default(0.00) @db.Decimal(15, 2)
  status                  String           @default("UNPAID") // DRAFT, SENT, UNPAID, PARTIAL, PAID, OVERDUE, CANCELLED
  orderNumber             String?
  salesperson             String?
  subject                 String?
  notes                   String?
  terms                   String?
  shippingAddress         String?
  receiptUrl              String?
  journalEntryId          String?          @unique
  importBatchId           String?
  isArchived              Boolean          @default(false)
  archivedAt              DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  customer                Customer         @relation(fields: [customerId], references: [id])
  project                 Project?         @relation(fields: [projectId], references: [id])
  financialYear           FinancialYear    @relation(fields: [financialYearId], references: [id])
  journalEntry            JournalEntry?    @relation(fields: [journalEntryId], references: [id])
  importBatch             ImportBatch?     @relation(fields: [importBatchId], references: [id])
  salesOrderId            String?
  salesOrder              SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  items                   InvoiceItem[]
  payments                InvoicePayment[]
  creditDebitNotes        CreditDebitNote[]
}

model InvoiceItem {
  id            String   @id @default(cuid())
  invoiceId     String
  description   String
  subDescription String?
  hsnSacCode    String   // SAC 9954, HSN 7210, etc.
  quantity      Decimal  @default(1.00) @db.Decimal(15, 2)
  unit          String   @default("SQFT") // SQFT, RFT, MT, NOS, LOT
  unitPrice     Decimal  @db.Decimal(15, 2)
  discount      Decimal  @default(0.00) @db.Decimal(15, 2)
  taxableAmount Decimal  @db.Decimal(15, 2)
  gstRate       Decimal  @default(18.00) @db.Decimal(5, 2)
  cgstRate      Decimal  @default(9.00) @db.Decimal(5, 2)
  cgstAmount    Decimal  @default(0.00) @db.Decimal(15, 2)
  sgstRate      Decimal  @default(9.00) @db.Decimal(5, 2)
  sgstAmount    Decimal  @default(0.00) @db.Decimal(15, 2)
  igstRate      Decimal  @default(0.00) @db.Decimal(5, 2)
  igstAmount    Decimal  @default(0.00) @db.Decimal(15, 2)
  totalAmount   Decimal  @db.Decimal(15, 2)
  createdAt     DateTime @default(now())

  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoicePayment {
  id              String        @id @default(cuid())
  invoiceId       String
  paymentDate     DateTime      @default(now())
  amount          Decimal       @db.Decimal(15, 2)
  tdsAmount       Decimal       @default(0.00) @db.Decimal(15, 2) // TDS u/s 194C
  paymentMode     String        @default("NEFT") // CASH, NEFT, RTGS, UPI, CHEQUE
  referenceNumber String?
  notes           String?
  journalEntryId  String?
  importBatchId   String?
  createdAt       DateTime      @default(now())

  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id])
  importBatch     ImportBatch?  @relation(fields: [importBatchId], references: [id])
}

// -------------------------------------------------------------
// SUPPLIERS & PURCHASE BILLS
// -------------------------------------------------------------

model Supplier {
  id                 String         @id @default(cuid())
  name               String
  companyName        String?
  gstNumber          String?
  panNumber          String?
  state              String         @default("Tamil Nadu")
  stateCode          String         @default("33")
  address            String?
  email              String?
  phone              String?
  paymentTerms       String?        // 15 days, 30 days, Immediate
  bankName           String?
  accountNumber      String?
  ifscCode           String?
  outstandingBalance Decimal        @default(0.00) @db.Decimal(15, 2)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  journalLines       JournalLine[]
  purchaseBills      PurchaseBill[]
  purchaseOrders     PurchaseOrder[]
  billPayments       BillPayment[]
  expenses           ExpenseClaim[]
  materialMovements  MaterialStockMovement[]
  fixedAssets        FixedAsset[]
  creditDebitNotes   CreditDebitNote[]
  advances           SupplierAdvance[]
}

model PurchaseBill {
  id                  String         @id @default(cuid())
  billNumber          String         @unique // PB/26-27/0001
  vendorInvoiceNumber String?        // Vendor's Tax Invoice No
  date                DateTime
  dueDate             DateTime?
  supplierId          String
  projectId           String?
  financialYearId     String
  subTotal            Decimal        @default(0.00) @db.Decimal(15, 2)
  cgstTotal           Decimal        @default(0.00) @db.Decimal(15, 2)
  sgstTotal           Decimal        @default(0.00) @db.Decimal(15, 2)
  igstTotal           Decimal        @default(0.00) @db.Decimal(15, 2)
  totalAmount         Decimal        @default(0.00) @db.Decimal(15, 2)
  amountPaid          Decimal        @default(0.00) @db.Decimal(15, 2)
  balanceDue          Decimal        @default(0.00) @db.Decimal(15, 2)
  status              String         @default("UNPAID") // UNPAID, PARTIAL, PAID
  receiptUrl          String?
  journalEntryId      String?        @unique
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  supplier            Supplier       @relation(fields: [supplierId], references: [id])
  project             Project?       @relation(fields: [projectId], references: [id])
  financialYear       FinancialYear  @relation(fields: [financialYearId], references: [id])
  journalEntry        JournalEntry?  @relation(fields: [journalEntryId], references: [id])
  purchaseOrderId     String?
  purchaseOrder       PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  items               PurchaseItem[]
  payments            BillPayment[]
  fixedAssets         FixedAsset[]
  creditDebitNotes    CreditDebitNote[]
}

model PurchaseItem {
  id             String       @id @default(cuid())
  purchaseBillId String
  description    String
  hsnSacCode     String
  quantity       Decimal      @default(1.00) @db.Decimal(15, 2)
  unit           String       @default("TON") // TON, SQFT, NOS, MTR
  unitPrice      Decimal      @db.Decimal(15, 2)
  taxableAmount  Decimal      @db.Decimal(15, 2)
  gstRate        Decimal      @default(18.00) @db.Decimal(5, 2)
  cgstAmount     Decimal      @default(0.00) @db.Decimal(15, 2)
  sgstAmount     Decimal      @default(0.00) @db.Decimal(15, 2)
  igstAmount     Decimal      @default(0.00) @db.Decimal(15, 2)
  totalAmount    Decimal      @db.Decimal(15, 2)
  createdAt      DateTime     @default(now())

  purchaseBill   PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// SITE & OFFICE EXPENSES
// -------------------------------------------------------------

model ExpenseClaim {
  id             String        @id @default(cuid())
  voucherNumber  String        @unique // EXP/26-27/0001
  date           DateTime      @default(now())
  accountId      String        // Linked expense account
  paymentMode    String        @default("CASH") // CASH, BANK
  bankAccountId  String?
  projectId      String?
  employeeId     String?
  supplierId     String?
  amount         Decimal       @db.Decimal(15, 2)
  purpose        String
  category       String?       // MATERIAL, LABOUR, CONTRACTOR, TRANSPORT, FOOD_STAY, OFFICE_OVERHEAD, SITE_MISC
  isOfficeExpense Boolean      @default(false)
  teamName       String?       // SRM01-SRM06, Team Thenarrusu, Team Saran, Office
  receiptUrl     String?
  status         String        @default("APPROVED") // PENDING, APPROVED, POSTED
  approvedById   String?
  approvedAt     DateTime?
  journalEntryId String?       @unique
  importBatchId  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  account        Account       @relation(fields: [accountId], references: [id])
  bankAccount    BankAccount?  @relation(fields: [bankAccountId], references: [id])
  project        Project?      @relation(fields: [projectId], references: [id])
  employee       EmployeeOrLabour? @relation(fields: [employeeId], references: [id])
  supplier       Supplier?     @relation(fields: [supplierId], references: [id])
  approvedBy     User?         @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  importBatch    ImportBatch?  @relation(fields: [importBatchId], references: [id])
}

// -------------------------------------------------------------
// CONTRACTORS & WORK-STAGE MILESTONES
// -------------------------------------------------------------

model Contractor {
  id            String                @id @default(cuid())
  code          String?               @unique // CON001, SRM01-CONT
  name          String
  specialty     String                // Roofing Installation, Fabrication, Sheeting
  fatherName    String?
  address       String?
  aadhaarNumber String?
  panNumber     String?
  phone         String?
  bankName      String?
  bankAccountNo String?
  bankIfsc      String?
  ifscCode      String?
  category      String                @default("CONTRACTOR_TEAM")
  companyId     String                @default("standard-roofs")
  status        String                @default("ACTIVE")
  contractValue Decimal               @default(0.00) @db.Decimal(15, 2)
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  milestones    ContractorMilestone[]
  journalLines  JournalLine[]
  dailyLogs     ContractorDailyLog[]

  @@index([companyId])
}

model ContractorMilestone {
  id                   String        @id @default(cuid())
  contractorId         String
  projectId            String
  milestoneType        String        // STAGE_10_ADVANCE, STAGE_40_PROGRESS, STAGE_75_STRUCTURE, STAGE_100_COMPLETION
  milestonePercentage  Decimal       @db.Decimal(5, 2) // 10.00, 40.00, 75.00, 100.00
  milestoneAmount      Decimal       @db.Decimal(15, 2)
  tdsRate              Decimal       @default(1.00) @db.Decimal(5, 2) // 1% for Ind/HUF, 2% for Co/Firm u/s 194C
  tdsAmount            Decimal       @default(0.00) @db.Decimal(15, 2)
  netPayable           Decimal       @default(0.00) @db.Decimal(15, 2)
  status               String        @default("PENDING") // PENDING, APPROVED, PAID
  workStageDescription String
  certifiedBy          String?
  approvedDate         DateTime?
  journalEntryId       String?
  teamName             String?
  importBatchId        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  contractor           Contractor    @relation(fields: [contractorId], references: [id])
  project              Project       @relation(fields: [projectId], references: [id])
  importBatch          ImportBatch?  @relation(fields: [importBatchId], references: [id])
}

// -------------------------------------------------------------
// SMART EXCEL ACCOUNTS IMPORT BATCHES & ROLLBACK
// -------------------------------------------------------------

model ImportBatch {
  id           String   @id @default(cuid())
  batchNumber  String   @unique // BATCH-2026-0001
  fileName     String
  fileType     String   @default("ACCOUNTS_EXCEL") // ACCOUNTS_EXCEL, CUSTOMERS, SUPPLIERS, etc.
  totalRows    Int      @default(0)
  totalInflow  Decimal  @default(0.00) @db.Decimal(15, 2)
  totalOutflow Decimal  @default(0.00) @db.Decimal(15, 2)
  sitesCount   Int      @default(0)
  status       String   @default("COMMITTED") // COMMITTED, ROLLED_BACK
  notes        String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy            User?                 @relation(fields: [createdById], references: [id])
  invoices             Invoice[]
  expenses             ExpenseClaim[]
  cashBookEntries      CashBookEntry[]
  journalEntries       JournalEntry[]
  invoicePayments      InvoicePayment[]
  contractorMilestones ContractorMilestone[]
}

// -------------------------------------------------------------
// EMPLOYEES & 15-DAY LABOUR MUSTER
// -------------------------------------------------------------

model EmployeeOrLabour {
  id                 String             @id @default(cuid())
  employeeCode       String             @unique // EMP001, LAB001, SR001, Invi001, 20001
  empCode            String?            // Alias / searchable workforce code
  name               String
  fatherName         String?
  phone              String?
  address            String?
  aadhaarNumber      String?
  panNumber          String?
  bankName           String?
  bankAccountNo      String?
  bankIfsc           String?
  ifscCode           String?
  bankAccountName    String?
  bankAccountNumber  String?
  bankBranch         String?
  dob                String?
  photoUrl           String?
  panDocUrl          String?
  aadhaarDocUrl      String?
  drivingLicenseNumber String?
  drivingLicenseDocUrl String?
  kycDocumentsJson   String?            // JSON array of soft-copy vault documents [{id,label,url,fileName,ext,uploadedAt}]
  tenthDetails       String?
  twelfthDetails     String?
  graduationDetails  String?
  experienceJson     String?
  contractorLeadName String?
  defaultHeadcount   Int?               @default(1)
  tradeSpecialty     String?
  designation        String?
  role               String?
  roleType           RoleType           @default(DAILY_LABOUR)
  payCycle           PayCycle           @default(FIFTEEN_DAYS) // 15-day pay cycle default
  category           String             @default("TAMIL_LABOUR") // OFFICE_STAFF, TAMIL_LABOUR, HINDI_LABOUR, CONTRACTOR_TEAM
  companyUnit        String             @default("STANDARD_ROOFS") // STANDARD_ROOFS, INVI_CREATION
  companyId          String             @default("standard-roofs")
  status             String             @default("ACTIVE") // ACTIVE, ARCHIVED
  baseWage           Decimal            @default(0.00) @db.Decimal(15, 2) // Per day / 15-day base wage
  dailyWage          Decimal            @default(0.00) @db.Decimal(15, 2) // Per day wage for site labours
  monthlySalary      Decimal            @default(0.00) @db.Decimal(15, 2) // Fixed monthly salary for office staff
  cashAdvanceBalance      Decimal            @default(0.00) @db.Decimal(15, 2)
  defaultVehicleAllowance Float              @default(0)
  reportingManagerCode    String?            // SR006 (Sri Manikandan) for SR004/SR007/SR008; SR009 (Gowri) for others
  location                String             @default("ERODE")
  state                   String             @default("TAMIL NADU")
  dateOfJoining           DateTime?
  offerLetterIssuedAt     DateTime?
  offerLetterTerms        String?
  resignationDate         DateTime?
  lastWorkingDate         DateTime?
  exitStatus              String             @default("ACTIVE") // ACTIVE, NOTICE_PERIOD, EXITED
  handoverChecklistJson   String?
  fnfSettlementAmount     Float?
  fnfSettledAt            DateTime?
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  expenses           ExpenseClaim[]
  musters            LabourMuster[]
  advances           LabourAdvance[]
  payrolls           StaffPayroll[]
  attendances        AttendanceRecord[]
  leaveRequests      LeaveRequest[]
  performanceReviews PerformanceReview[]

  @@index([companyId])
}

model AttendanceRecord {
  id              String           @id @default(cuid())
  employeeId      String
  date            DateTime         @db.Date
  status          String           // P (Present), H (Half-Day), 1H (1-Hour Permission), A (Absent), L (Leave/Sunday)
  inTime          String?          // e.g. "09:05 AM"
  outTime         String?          // e.g. "07:05 PM"
  siteName        String?          // e.g. "SSM School", "Kalloviyam Gokul", "Unloading", "Office"
  dailyAdvance    Decimal          @default(0.00) @db.Decimal(15, 2) // Optional ₹ petty advance on site
  permissionNote    String?          // Reason for 1H/15m-3h permission or work notes
  permissionHours   Decimal?         @default(1.0) @db.Decimal(5, 2)
  permissionMinutes Int              @default(0) // 15m..180m (3h) in 15-min increments
  permissionStatus  String?          // PENDING | APPROVED | REJECTED | UNAPPROVED_LATE
  permissionSlot    String?          // "MORNING" | "EVENING"
  permissionTime    String?          // e.g. "09:00 AM - 10:00 AM" or "06:30 PM - 07:30 PM"
  otHours           Float            @default(0) // Overtime hours (0.5, 1, 1.5, 2, etc.)
  otApprovalStatus  String?          // PENDING | APPROVED | REJECTED
  otTimeRange       String?          // e.g. "07:30 PM - 09:30 PM"
  otReason        String?          // Overtime reason / site description
  workNotes       String?          // Remarks, work notes
  category        String?          // OFFICE_STAFF, TAMIL_LABOUR, HINDI_LABOUR
  companyUnit     String?          // STANDARD_ROOFS, INVI_CREATION
  companyId       String           @default("standard-roofs")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  employee        EmployeeOrLabour @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId, date])
  @@index([category])
  @@index([category, date])
  @@index([companyId])
}

model CompanyHoliday {
  id          String   @id @default(cuid())
  date        DateTime @unique @db.Date
  name        String   // e.g. "Deepavali", "New Year", "Pongal", "Saraswathi Pooja"
  year        Int      @default(2026)
  holidayType String   @default("PL") // "PL" (Paid Leave = 1.0), "UP" (Non-Paid Leave = 0.0), "HALF_PAID" (Half-Day Paid Leave = 0.5)
  description String?
  companyId   String   @default("ALL") // ALL | standard-roofs | invi-creation
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([year])
  @@index([companyId])
}

model ContractorDailyLog {
  id                 String      @id @default(cuid())
  contractorTeamName String      // "Nandeeshwaran Team", "Contractor Sakthi", "Prashop Team", "Monier Suresh Team", "Suthish Team", "Hydarali Team"
  contractorId       String?
  date               DateTime    @db.Date
  siteName           String?     // "Ravichandran Chennai", "Arunprasad Uthukuli", "Ananthi Thindal", etc.
  headcount          Int         @default(0) // Number of labours working
  workerBreakdown    String?     // "Rajkumar-F, Mani-H, Selvam-H"
  siteWorkStatus     String?     // "Fabrication Work", "Purlin Work Welding", "Sheeting", "Rain season", "Absent/No Work"
  otHours            Float       @default(0) // Overtime hours for team
  otTimeRange        String?     // e.g. "07:00 PM - 09:00 PM"
  otReason           String?
  remarks            String?
  companyId          String      @default("standard-roofs")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  contractor         Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([contractorTeamName])
  @@index([contractorTeamName, date])
  @@index([companyId])
}

model LeaveRequest {
  id               String           @id @default(cuid())
  employeeId       String
  companyId        String           @default("standard-roofs")
  leaveCategory    String           @default("PLANNED") // PLANNED, UNPLANNED, SICK, EMERGENCY
  dayType          String           @default("FULL_DAY") // FULL_DAY, HALF_DAY
  startDate        DateTime         @db.Date
  endDate          DateTime         @db.Date
  totalDays        Decimal          @default(1.0) @db.Decimal(5, 2)
  reason           String
  assignedTeamLead String?
  assignedApproverCode String?       // SR006 | SR009
  teamLeadStatus   String           @default("PENDING") // PENDING, APPROVED, REJECTED
  teamLeadBy       String?
  teamLeadAt       DateTime?
  teamLeadRemarks  String?
  hrStatus         String           @default("PENDING") // PENDING, APPROVED, REJECTED
  hrBy             String?
  hrAt             DateTime?
  hrRemarks        String?
  status           String           @default("PENDING_TEAM_LEAD") // PENDING_TEAM_LEAD, PENDING_HR, APPROVED, REJECTED
  reviewedBy       String?
  reviewedAt       DateTime?
  rejectionNote    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  employee         EmployeeOrLabour @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([companyId])
}

model PerformanceReview {
  id                    String           @id @default(cuid())
  employeeId            String
  month                 String           // YYYY-MM
  attendanceScore       Int              @default(25) // out of 25
  siteExecutionScore    Int              @default(25) // out of 25
  punctualityScore      Int              @default(25) // out of 25
  safetyDisciplineScore Int              @default(25) // out of 25
  overallRating         Int              @default(100) // 0-100
  recommendedIncentive  Float            @default(0)
  reviewerNotes         String?
  reviewedBy            String?
  appliedToPayroll      Boolean          @default(false)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  employee              EmployeeOrLabour @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month])
  @@index([month])
}

model LabourMuster {
  id               String            @id @default(cuid())
  employeeId       String
  periodStart      DateTime
  periodEnd        DateTime
  daysWorked       Decimal           @default(15.00) @db.Decimal(5, 2)
  overtimeHours    Decimal           @default(0.00) @db.Decimal(5, 2)
  grossWage        Decimal           @db.Decimal(15, 2)
  advanceDeduction Decimal           @default(0.00) @db.Decimal(15, 2)
  netPayout        Decimal           @db.Decimal(15, 2)
  paymentMode      String            @default("CASH") // CASH, BANK
  status           String            @default("PAID") // DRAFT, PAID
  payoutDate       DateTime          @default(now())
  journalEntryId   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  employee         EmployeeOrLabour  @relation(fields: [employeeId], references: [id])
  journalEntry     JournalEntry?     @relation(fields: [journalEntryId], references: [id])
}

model LabourAdvance {
  id             String            @id @default(cuid())
  employeeId     String
  date           DateTime          @default(now())
  amount         Decimal           @db.Decimal(15, 2)
  purpose        String
  status         String            @default("OUTSTANDING") // OUTSTANDING, DEDUCTED
  journalEntryId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  employee       EmployeeOrLabour  @relation(fields: [employeeId], references: [id])
  journalEntry   JournalEntry?     @relation(fields: [journalEntryId], references: [id])
}

// -------------------------------------------------------------
// MACHINE & TOOL ASSETS TRACKING (SRM01 - SRM06)
// -------------------------------------------------------------

model MachineAsset {
  id              String              @id @default(cuid())
  assetCode       String              @unique // SRM01 ... SRM06, SRM-OFF-01, etc.
  sNo             Int?
  name            String
  category        String              // Power Tools, Bits & Scales, Bags & Safety, Heavy Vehicles
  modelNumber     String?
  serialNumber    String?
  purchaseDate    DateTime?
  purchaseCost    Decimal             @default(0.00) @db.Decimal(15, 2)
  currentStatus   MachineStatus       @default(AVAILABLE)
  currentLocation String              @default("Office")
  
  // Matrix counts directly matching 2026_SRMachines_Tracking_System.xlsx
  srFinalCount    Int                 @default(0)
  totalCount      Int                 @default(0)
  officeCount     Int                 @default(0)
  srm01Count      Int                 @default(0)
  srm02Count      Int                 @default(0)
  srm03Count      Int                 @default(0)
  srm04Count      Int                 @default(0)
  srm05Count      Int                 @default(0)
  srm06Count      Int                 @default(0)
  spareCount      Int                 @default(0)
  serviceCount    Int                 @default(0)
  scrapCount      Int                 @default(0)
  notes           String?
  imageUrl        String?
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  allocations     MachineAllocation[]
  movements       MachineMovement[]
  repairs         MachineServiceRepair[]
}

model MachineAllocation {
  id              String        @id @default(cuid())
  machineId       String
  projectId       String?
  allocationGroup MachineGroup  @default(OFFICE) // SRM01 - SRM06, OFFICE, SPARE, SERVICE, SCRAP
  allocatedDate   DateTime      @default(now())
  releaseDate     DateTime?
  status          String        @default("ACTIVE") // ACTIVE, RELEASED
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  machine         MachineAsset  @relation(fields: [machineId], references: [id])
  project         Project?      @relation(fields: [projectId], references: [id])
}

model MachineMovement {
  id                     String        @id @default(cuid())
  machineId              String
  fromLocation           String
  toLocation             String
  movementDate           DateTime      @default(now())
  purpose                String
  issuedById             String
  approvedById           String
  repairCost             Decimal?      @db.Decimal(15, 2)
  repairExpenseAccountId String?
  status                 String        @default("RECEIVED") // PENDING, DISPATCHED, RECEIVED
  notes                  String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  machine                MachineAsset  @relation(fields: [machineId], references: [id])
  issuedBy               User          @relation("MachineIssuedBy", fields: [issuedById], references: [id])
  approvedBy             User          @relation("MachineApprovedBy", fields: [approvedById], references: [id])
}

model MachineServiceRepair {
  id               String       @id @default(cuid())
  machineId        String
  vendorName       String       // Mechanic / Service Vendor
  faultDescription String
  repairCost       Decimal      @default(0.00) @db.Decimal(15, 2)
  status           String       @default("IN_SERVICE") // IN_SERVICE, REPAIRED, SCRAPPED
  sentDate         DateTime     @default(now())
  expectedReturn   DateTime?
  returnedDate     DateTime?
  journalEntryId   String?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  machine          MachineAsset @relation(fields: [machineId], references: [id])
}

model SiteMaterialIssue {
  id               String       @id @default(cuid())
  date             DateTime     @default(now())
  team             String       @default("SRM01") // SRM01 .. SRM06, OFFICE
  siteName         String?      // e.g. Gem Hospital, Vellalar Edu. Trust, etc.
  projectId        String?
  productName      String
  quantity         Decimal      @db.Decimal(15, 2)
  returnedQty      Decimal      @default(0.00) @db.Decimal(15, 2)
  isReturnable     Boolean      @default(false)
  issuedBy         String       @default("Gowri Sankar")
  approvedBy       String       @default("Siva Kumar")
  condition        String       @default("Good") // Good, Worn, Damaged
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  project          Project?     @relation(fields: [projectId], references: [id])
}

// -------------------------------------------------------------
// AUDIT LOG
// -------------------------------------------------------------

model AuditLog {
  id            String   @id @default(cuid())
  action        String   // CREATE, UPDATE, POST, REVERSAL
  entityType    String   // JournalEntry, CashBookEntry, Invoice, MachineMovement
  entityId      String
  oldValues     String?  @db.Text
  newValues     String?  @db.Text
