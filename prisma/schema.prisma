  odometerKm      Int              @default(0)
  insuranceExpiry DateTime?
  fitnessExpiry   DateTime?        // FC expiry
  permitExpiry    DateTime?
  status          String           @default("ACTIVE") // ACTIVE, MAINTENANCE, INACTIVE
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  trips           VehicleTripLog[]
}

model Driver {
  id              String           @id @default(cuid())
  name            String
  licenseNumber   String?
  phone           String
  salaryType      String           @default("MONTHLY") // MONTHLY, TRIP_BATA
  monthlySalary   Decimal          @default(0.00) @db.Decimal(15, 2)
  tripBataRate    Decimal          @default(0.00) @db.Decimal(15, 2)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

