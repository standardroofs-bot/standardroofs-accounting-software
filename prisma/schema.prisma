  remainingBalance Decimal       @db.Decimal(15, 2)
  status           String        @default("ACTIVE") // ACTIVE, FULLY_ADJUSTED
  notes            String?
  journalEntryId   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer         Customer      @relation(fields: [customerId], references: [id])
  journalEntry     JournalEntry? @relation(fields: [journalEntryId], references: [id])
}

model SupplierAdvance {
  id               String        @id @default(cuid())
  paymentNumber    String        @unique // ADV-DR/26-27/0001
  date             DateTime      @default(now())
  supplierId       String
  projectId        String?
  amount           Decimal       @db.Decimal(15, 2)
  paymentMode      String        @default("BANK") // BANK, CASH
  bankAccountId    String?
  referenceNumber  String?
  allocatedAmount  Decimal       @default(0.00) @db.Decimal(15, 2)
  remainingBalance Decimal       @db.Decimal(15, 2)
  status           String        @default("ACTIVE") // ACTIVE, FULLY_ADJUSTED
  notes            String?
  journalEntryId   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  supplier         Supplier      @relation(fields: [supplierId], references: [id])
  journalEntry     JournalEntry? @relation(fields: [journalEntryId], references: [id])
}

// -------------------------------------------------------------
// RECURRING INVOICES & EXPENSES
// -------------------------------------------------------------

model RecurringTemplate {
  id                String    @id @default(cuid())
  templateName      String
  type              String    // INVOICE, EXPENSE
  frequency         String    @default("MONTHLY") // WEEKLY, MONTHLY, QUARTERLY, ANNUAL
  nextDueDate       DateTime
  customerId        String?
  supplierId        String?
  category          String?   // Office Rent, Vehicle EMI, Crane Rental, Retainer Fee
  amount            Decimal   @db.Decimal(15, 2)
  description       String
  active            Boolean   @default(true)
  lastGeneratedDate DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// -------------------------------------------------------------
// ROOFING SERVICES & MATERIAL PRICE CATALOG
// -------------------------------------------------------------

model RoofingPriceItem {
  id          String   @id @default(cuid())
  itemCode    String   @unique // ROOF-CLAY-01, ROOF-PEB-01, ROOF-UPVC-01
  name        String
  category    String   @default("ROOFING_SERVICE") // ROOFING_SERVICE, RAW_MATERIAL, ACCESSORY
  roofType    String   @default("PEB") // PEB, Clay Tile, Tensile, UPVC, Solar
  hsnSacCode  String   @default("9954")
  unit        String   @default("Sq.Ft") // Sq.Ft, MT, Nos, Kg, Box
  defaultRate Decimal  @db.Decimal(15, 2)
  gstRate     Decimal  @default(18.00) @db.Decimal(5, 2)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


