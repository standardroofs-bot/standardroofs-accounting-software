# ==============================================================================
# STANDARD ROOFS BOOKS (SR-BOOKS) — ENVIRONMENT CONFIGURATION
# Local-First & Cloud-Ready ERP for Standard Roofs (Erode, Tamil Nadu)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# [LOCAL MODE - DEFAULT]
# Uses embedded PostgreSQL running locally on port 54329 (no external install needed)
DATABASE_URL="postgresql://postgres:srbooks_password_2026@127.0.0.1:54329/srbooks?schema=public"
DIRECT_URL="postgresql://postgres:srbooks_password_2026@127.0.0.1:54329/srbooks?schema=public"

# [CLOUD PRODUCTION MODE - e.g. NEON / SUPABASE / AWS RDS]
# Uncomment and replace with your managed cloud connection string:
# DATABASE_URL="postgresql://user:password@ep-standard-roofs-pooler.ap-southeast-1.aws.neon.tech/srbooks?sslmode=require"

# ------------------------------------------------------------------------------
# 2. FILE & RECEIPT STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# [LOCAL MODE - DEFAULT]
# Files stored locally under ./public/uploads/{financialYear}/{module}/
STORAGE_DRIVER="local"
STORAGE_DIR="./public/uploads"

# [CLOUD PRODUCTION MODE - CLOUDFLARE R2 OBJECT STORAGE]
# Set STORAGE_DRIVER="r2" and fill your R2 bucket credentials:
# STORAGE_DRIVER="r2"
# R2_ACCOUNT_ID="your_cloudflare_account_id"
# R2_ACCESS_KEY_ID="your_r2_access_key_id"
# R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# R2_BUCKET_NAME="standard-roofs-receipts"
# R2_PUBLIC_URL="https://uploads.standardroofs.in"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY (REQUIRED: >= 32 CHARS RANDOM STRING)
# ------------------------------------------------------------------------------
SESSION_SECRET="replace-with-a-random-64-char-hex-secret-in-production"

# ------------------------------------------------------------------------------
# 4. STATUTORY & COMPANY METADATA (TAMIL NADU GST CODE 33)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_COMPANY_NAME="Standard Roofs"
NEXT_PUBLIC_COMPANY_STATE="Tamil Nadu"
NEXT_PUBLIC_COMPANY_STATE_CODE="33"
NEXT_PUBLIC_COMPANY_GSTIN="33AABCS1234F1Z5"
NEXT_PUBLIC_COMPANY_PAN="AABCS1234F"
NEXT_PUBLIC_COMPANY_ADDRESS="12/4, Perundurai Road, Near Collectorate, Erode - 638011, Tamil Nadu"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
